{
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --type-aware src test smoke.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "build": "tsc -p tsconfig.build.json",
    "smoke": "node smoke.mjs",
    "verify": "npm run format:check && npm run lint && tsc -p tsconfig.json && npm test && npm run build && npm run smoke"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@nestjs/testing": "12.4.2",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.9.10",
    "supertest": "7.3.2",
    "typescript": "7.0.2"
  }
}
